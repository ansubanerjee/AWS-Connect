ser = serial.Serial(COM_PORT, BAUD_RATE, timeout=1)

def sendAT(cmd, delay_ms=500):
    print(f">> {cmd}")
    ser.write((cmd + "\r\n").encode())
    time.sleep(delay_ms/1000.0)
    

def getResponse(timeout_ms=2000):
    end_t = time.time() + (timeout_ms/1000.0)
    buf = ""
    while time.time() < end_t:
        if ser.in_waiting:
            buf += ser.read(ser.in_waiting).decode(errors="ignore")
    return buf.strip()

def waitFor(expected, timeout_ms=5000):
    end_t = time.time() + (timeout_ms/1000.0)
    data = ""
    while time.time() < end_t:
        if ser.in_waiting:
            chunk = ser.read(ser.in_waiting).decode(errors="ignore")
            data += chunk
            if expected in data:
                return True
    return False

def flushSerial():
    while ser.in_waiting:
        ser.read(ser.in_waiting)

def initializeModem():
    flushSerial()
    sendAT("AT")
    if not waitFor("OK", 3000): return False
    sendAT("ATE0"); waitFor("OK", 2000)
    sendAT("AT+CMEE=2"); waitFor("OK", 2000)
    sendAT("AT+CPIN?"); 
    if not waitFor("+CPIN: READY", 3000): return False
    sendAT("AT+CSQ"); waitFor("OK", 2000)
    sendAT("AT+CEREG?"); 
    if not waitFor(",1", 3000):
        sendAT("AT+CREG?")
        if not waitFor("0,1", 3000) and not waitFor("0,5", 3000):
            return False
    sendAT(f'AT+CGDCONT=1,"IP","{APN}"'); waitFor("OK", 3000)
    sendAT("AT+NETCLOSE"); waitForEither("+NETCLOSE:", "OK", 5000)
    sendAT("AT+NETOPEN"); waitForEither("+NETOPEN: 0", "ALREADY CONNECT", 30000)
    sendAT("AT+IPADDR"); waitFor("+IPADDR", 5000)
    return True

def waitForEither(a, b, timeout_ms=10000):
    """
    Wait for either substring 'a' or 'b' to appear in serial response.
    Returns True if either is found within timeout, else False.
    """
    end_time = time.time() + (timeout_ms / 1000.0)
    response = ""
    while time.time() < end_time:
        if ser.in_waiting:
            chunk = ser.read(ser.in_waiting).decode(errors="ignore")
            response += chunk
            if (a and a in response) or (b and b in response):
                print(f"<< {response}")
                return True
        time.sleep(0.01)
    print(f"<< {response}")
    print(f"ERROR: neither '{a}' nor '{b}' found")
    return False


def cert_present(filename):
    sendAT("AT+CCERTLIST", 300)
    resp = getResponse(3000)
    return filename in resp

def upload_ca_if_needed(pem_data, modem_name):
    if cert_present(modem_name):
        print(f"Root CA already present as '{modem_name}'.")
        return True
    blob = pem_data.encode()
    print(f"Uploading Root CA to module as '{modem_name}' ({len(blob)} bytes)...")
    sendAT(f'AT+CCERTDOWN="{modem_name}",{len(blob)}', 300)
    if not waitFor(">", 3000):
        print("Modem did not accept CCERTDOWN.")
        return False
    ser.write(blob)
    ser.write(b"\x1A")  
    ok = waitFor("OK", 15000)
    print("Upload OK" if ok else "Upload failed")
    return ok

def configure_ssl_context_for_api_gw(ctx=0):
    sendAT(f'AT+CSSLCFG="sslversion",{ctx},3', 300)
    waitFor("OK", 3000)
    sendAT(f'AT+CSSLCFG="authmode",{ctx},1', 300)
    waitFor("OK", 3000)
    sendAT(f'AT+CSSLCFG="ignorelocaltime",{ctx},1', 300)
    waitFor("OK", 3000)
    sendAT(f'AT+CSSLCFG="negotiatetime",{ctx},120', 300)
    waitFor("OK", 3000)
    sendAT(f'AT+CSSLCFG="cacert",{ctx},"{MODEM_CA_NAME}"', 300)
    return waitFor("OK", 3000)

def setupLTE():
    """
    Attach to LTE network, open PDP context, and ensure IP is assigned.
    Returns True if successful, False otherwise.
    """
    sendAT(f'AT+CGDCONT=1,"IP","{APN}"')
    if not waitFor("OK", 3000):
        print("Failed to set PDP context")
        return False

    sendAT("AT+NETCLOSE")
    waitForEither("+NETCLOSE:", "OK", 5000)
    
    sendAT("AT+NETOPEN")
    if not waitForEither("+NETOPEN: 0", "ALREADY CONNECT", 30000):
        print("Failed to open LTE network session")
        return False

    sendAT("AT+IPADDR")
    if not waitFor("+IPADDR", 5000):
        print("Warning: IP address not obtained")

    print("LTE network ready with PDP context")
    return True


def httpPostAWS(json_data, ctx=0):
    sendAT(f'AT+CHTTPSOPSE="{HOST}",{PORT},{ctx}', 1000)
    if not waitFor("OK", 5000):
        print("Failed to open SSL session")
        return False
    sendAT(f'AT+CHTTPSHEAD=1,"{PATH}","Content-Type: application/json"', 500)
    if not waitFor("OK", 3000):
        print("Failed to set headers")
        return False
    sendAT(f'AT+CHTTPSSEND={len(json_data)}', 500)
    if not waitFor(">", 3000):
        print("Modem did not accept data")
        return False
    ser.write(json_data.encode())
    ser.write(b"\x1A")
    if not waitFor("OK", 10000):
        print("HTTPS POST failed")
        return False
    sendAT('AT+CHTTPSCLSE', 500)
    waitFor("OK", 3000)
    return True

def checkTLSCapability():
    print("Checking TLS capability...")
    sendAT("AT+CSSLCFG=?")
    resp = getResponse(3000)
    print("CSSLCFG response:", resp)
    if "ERROR" in resp:
        print("Modem does not support CSSLCFG (TLS config).")
        return False
    return True


